# =============================================================================
# CONFIGURAÇÃO DA NOVA AGENDA 2027 — copie para .env e ajuste (o instalar.sh faz isso)
# Não coloque senhas aqui: a senha do banco fica em secrets/db_password.txt
# =============================================================================

# Nome e IP pelos quais os usuários acessam o sistema na Intranet
SERVIDOR_NOME=agenda.hospital.local
SERVIDOR_IP=

# Portas publicadas na VM
HTTPS_PORTA=443
HTTP_PORTA=80

# Fuso horário (agenda, backup e logs)
TZ=America/Sao_Paulo

# Backup automático: formato cron (minuto hora dia mês dia-semana). Padrão: todo dia às 00:00
BACKUP_CRON=0 0 * * *
# Quantos dias de cópias manter
BACKUP_RETENCAO_DIAS=30

# Sessão e login
SESSAO_INATIVIDADE_MIN=30
SESSAO_MAXIMA_HORAS=12
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MIN=15

# Consulta de CEP na internet (ViaCEP/BrasilAPI). 0 = preenchimento só manual
CEP_ONLINE=1

# Parâmetros do setor
QTD_POLTRONAS=12
HORAS_FUNCIONAMENTO_DIA=10
NOME_INSTITUICAO=INSTITUTO NACIONAL DE CÂNCER — INCA / HOSPITAL DE CÂNCER II (HC II)

LOG_LEVEL=INFO
